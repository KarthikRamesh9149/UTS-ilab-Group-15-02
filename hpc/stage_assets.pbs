#!/bin/bash
# Stage 1 of 2: download the vLLM container and model weights.
#
# Runs on workq with NO GPU - downloading does not need one, and the GPU queues
# have a ~7 hour wait we should not spend on network I/O.
#
# Assets live in $HOME, NOT /scratch. /scratch is node-LOCAL on this cluster
# (exec03=/dev/sdb1 11T, exec19=/dev/nvme0n1p1 3.5T - different physical disks),
# so anything staged there is invisible to the GPU node that later runs the server.
# $HOME is /shared/homes over NFS: visible from every node, 1 TB, no quota.
#
# Built as a single compressed .sif rather than a sandbox directory: a sandbox is
# tens of thousands of small files, which is slow to create and slow to execute
# over NFS. Creating a .sif runs mksquashfs, which threads across every visible
# core - that killed the 4-CPU attempt ("ncpus 6.8 exceeded limit 4"), so this
# asks for 12.
#PBS -N stage-assets
#PBS -q workq
#PBS -l select=1:ncpus=12:mem=64gb
#PBS -l walltime=08:00:00
#PBS -j oe

set -u

ASSETS=$HOME/tb-assets
SIF=$ASSETS/vllm-openai.sif
MODEL_DIR=$ASSETS/models
MODEL_REPO=Qwen/Qwen2.5-Coder-32B-Instruct-AWQ
TARGET=$MODEL_DIR/Qwen2.5-Coder-32B-Instruct-AWQ

# Build scratch is fine to keep node-local - it is thrown away when the job ends.
export APPTAINER_CACHEDIR=/scratch/$USER/apptainer-cache
export APPTAINER_TMPDIR=/scratch/$USER/apptainer-tmp
export TMPDIR=/scratch/$USER/tmp

mkdir -p "$ASSETS" "$MODEL_DIR" "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR" "$TMPDIR"

echo "==================== START ===================="
date; hostname
echo "cpus granted: ${NCPUS:-unknown}"
echo "assets dir:   $ASSETS"
df -h "$HOME" | tail -n 1

echo
echo "==================== 1. vLLM CONTAINER (.sif in shared HOME) ===================="
if [ -f "$SIF" ]; then
    echo "already present: $SIF ($(du -h "$SIF" | cut -f1))"
else
    echo "building $SIF from docker://vllm/vllm-openai:latest"
    apptainer build --force "$SIF" docker://vllm/vllm-openai:latest
    echo "build exit=$? size=$(du -h "$SIF" 2>/dev/null | cut -f1)"
fi

echo
echo "==================== 2. FIND THE INTERPRETER ===================="
# The image ships python3, not python - the previous attempt failed on every
# step with '"python": executable file not found'. Probe rather than assume,
# and print enough to diagnose if this changes.
echo "--- PATH inside container ---"
apptainer exec "$SIF" sh -c 'echo "$PATH"'
echo "--- candidate interpreters ---"
for candidate in python3 python /usr/bin/python3 /usr/local/bin/python3; do
    if apptainer exec "$SIF" sh -c "command -v $candidate" >/dev/null 2>&1; then
        echo "FOUND: $candidate"
    else
        echo "absent: $candidate"
    fi
done

PY=""
for candidate in python3 python /usr/bin/python3 /usr/local/bin/python3; do
    if apptainer exec "$SIF" sh -c "command -v $candidate" >/dev/null 2>&1; then
        PY=$candidate
        break
    fi
done
if [ -z "$PY" ]; then
    echo "FATAL: no python interpreter found inside the container"
    apptainer exec "$SIF" ls -la /usr/bin/ 2>/dev/null | grep -i python
    exit 1
fi
echo "using interpreter: $PY"

echo
echo "==================== 3. SANITY: versions and Turing support ===================="
apptainer exec "$SIF" "$PY" -c "import torch, vllm; print('vllm', vllm.__version__, '| torch', torch.__version__)" \
    || echo "WARNING: could not import vllm/torch"
echo "--- does this build include sm_75 (Turing) kernels? ---"
apptainer exec "$SIF" "$PY" -c "import torch; print('arch list:', torch.cuda.get_arch_list())" \
    || echo "(arch list unavailable)"
echo "--- is the vllm CLI on PATH? ---"
apptainer exec "$SIF" sh -c 'command -v vllm || echo "(no vllm CLI - will use: python3 -m vllm.entrypoints.openai.api_server)"'

echo
echo "==================== 4. MODEL WEIGHTS ===================="
# 4-bit AWQ so a 32B model fits in 2 x 24 GB with room for a 32k KV cache.
if [ -f "$TARGET/config.json" ]; then
    echo "already present: $TARGET ($(du -sh "$TARGET" | cut -f1))"
else
    echo "downloading $MODEL_REPO -> $TARGET"
    # Modest worker count: PBS enforces the CPU limit strictly.
    apptainer exec --bind "$HOME:$HOME" "$SIF" "$PY" -c "
from huggingface_hub import snapshot_download
p = snapshot_download('$MODEL_REPO', local_dir='$TARGET', max_workers=4)
print('downloaded to', p)
"
    echo "download exit=$?"
fi

echo
echo "==================== SUMMARY ===================="
du -sh "$SIF" 2>/dev/null
echo "--- model files ---"
ls -la "$TARGET" 2>/dev/null | head -20
du -sh "$TARGET" 2>/dev/null
df -h "$HOME" | tail -n 1
echo "==================== DONE ===================="
date
