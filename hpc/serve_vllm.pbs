#!/bin/bash
# Stage 2 of 2: serve the model on 2 GPUs and hold the server up.
#
# The GPU queue wait is hours, so this job does BOTH jobs at once: it verifies
# vLLM can start on Turing hardware AND then stays up as the inference endpoint
# for the benchmark run. A separate short "test" job would wait the same hours
# for less.
#
# Turing (sm_75) constraints, all of them load-bearing:
#   --dtype float16          bfloat16 raises a hard error below sm_80
#   no FlashAttention        unavailable below sm_80; vLLM falls back to Triton
#   float16 KV cache         FP8 KV cache needs newer hardware
#
# This image is vLLM 0.29.0 / torch 2.13.0+cu130, and torch.cuda.get_arch_list()
# reports sm_75 among its compiled architectures - so the Quadro RTX 6000s on this
# cluster are supported. Verified from the staged container before submitting.
#
# Sized for ONE GPU deliberately. At submission time every GPU on the cluster was
# allocated (pbsnodes showed ngpus f/t = 0/2 on essentially every node) with 14
# jobs queued ahead of us. A 2-GPU request must wait for two cards to free on the
# SAME node, which turns a long wait into a much longer one. 14B at 4-bit is
# ~9.5 GB and fits one 24 GB card with full 32k context, so the second card buys
# nothing here. Shorter walltime also improves the odds of backfilling a gap.
#
# For the 32B on two cards (weights ~19 GB, needs tensor parallelism):
#   qsub -l select=1:ncpus=8:ngpus=2:mem=64gb -l walltime=24:00:00 \
#        -v MODEL_REPO=Qwen2.5-Coder-32B-Instruct-AWQ,TP=2 hpc/serve_vllm.pbs
#PBS -N vllm-serve
#PBS -q small_gpuq
# 2 CPUs is enough: this server is GPU-bound, Harbor sends one request at a time,
# and a 6-CPU ask sat queued while hpc-exec02 had a free GPU but only 3 free CPUs.
# PBS kills a job that exceeds its CPU cap, so do not drop this to 1.
#PBS -l select=1:ncpus=2:ngpus=1:mem=48gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -u

# Assets live in $HOME because /scratch is node-local on this cluster and would
# be invisible from whichever GPU node this job lands on. See hpc/stage_assets.pbs.
ASSETS=$HOME/tb-assets
SIF=$ASSETS/vllm-openai.sif
# Directory name only, not the full HF repo id. Override with qsub -v MODEL_REPO=...
MODEL_REPO=${MODEL_REPO:-Qwen2.5-Coder-14B-Instruct-AWQ}
MODEL=$ASSETS/models/$MODEL_REPO
TP=${TP:-1}
# The name the harness asks for on the wire. Derived so it always matches the
# weights being served - a mismatch here is what the runner's preflight catches.
SERVED_NAME=$(echo "$MODEL_REPO" | tr 'A-Z' 'a-z' | sed 's/-instruct-awq/-awq/')
PORT=8000
ENDPOINT_FILE=$HOME/vllm-endpoint.txt
SERVER_LOG=$HOME/vllm-server.log

# Node-local scratch is fine for throwaway temp files.
export APPTAINER_CACHEDIR=/scratch/$USER/apptainer-cache
export APPTAINER_TMPDIR=/scratch/$USER/apptainer-tmp
export TMPDIR=/scratch/$USER/tmp
mkdir -p "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR" "$TMPDIR"

echo "==================== START ===================="
date; hostname
echo "model      : $MODEL_REPO"
echo "served as  : $SERVED_NAME   <- the runner's --model must match this"
echo "tensor par : $TP"
# GPUs on this cluster are shared: the earlier probe saw another user's 2.4 GB
# process on a card we had been allocated. 0.80 leaves room for that rather than
# failing to start.
nvidia-smi --query-gpu=index,name,memory.used,memory.total --format=csv

for path in "$SIF" "$MODEL/config.json"; do
    if [ ! -e "$path" ]; then
        echo "FATAL: missing $path - run hpc/stage_assets.pbs first"
        exit 1
    fi
done

# One token per job, written next to the endpoint details.
API_KEY=$(head -c 18 /dev/urandom | base64 | tr -d '/+=' | head -c 24)

cat > "$ENDPOINT_FILE" <<EOF
# vLLM endpoint for PBS job $PBS_JOBID
NODE=$(hostname)
PORT=$PORT
MODEL=$SERVED_NAME
API_KEY=$API_KEY
STARTED=$(date -Iseconds)

# Tunnel from a laptop (run on the laptop, needs UTS VPN):
#   ssh -N -L ${PORT}:$(hostname):${PORT} cetus
# Then point a harness at:
#   OPENAI_BASE_URL=http://127.0.0.1:${PORT}/v1
#   OPENAI_API_KEY=$API_KEY
EOF
echo "wrote $ENDPOINT_FILE"

echo
echo "==================== LAUNCHING vLLM ===================="
# FlashInfer's sampler has no sm_75 kernel; disabling it avoids a noisy fallback.
export APPTAINERENV_VLLM_USE_FLASHINFER_SAMPLER=0
export APPTAINERENV_HF_HUB_OFFLINE=1

apptainer exec --nv --bind "$HOME:$HOME" "$SIF" \
    vllm serve "$MODEL" \
        --served-model-name "$SERVED_NAME" \
        --dtype float16 \
        --kv-cache-dtype float16 \
        --tensor-parallel-size "$TP" \
        --max-model-len 32768 \
        --gpu-memory-utilization 0.80 \
        --host 0.0.0.0 \
        --port "$PORT" \
        --api-key "$API_KEY" \
    > "$SERVER_LOG" 2>&1 &
# No --disable-log-requests: it was removed in vLLM 0.29 (request logging is now
# off by default, opt in via --enable-log-requests). Passing it is an argparse
# error that kills the server on startup - which we would only have discovered
# after the multi-hour GPU queue wait. Every flag above was checked against this
# image's own source before submitting.

SERVER_PID=$!
echo "server pid=$SERVER_PID, log=$SERVER_LOG"

echo
echo "==================== WAITING FOR READINESS ===================="
READY=0
for i in $(seq 1 120); do   # up to 20 minutes; AWQ load on Turing is slow
    sleep 10
    if curl -s -f -H "Authorization: Bearer $API_KEY" \
         "http://127.0.0.1:$PORT/v1/models" > /dev/null 2>&1; then
        echo "READY after $((i*10))s"
        READY=1
        break
    fi
    if ! kill -0 "$SERVER_PID" 2>/dev/null; then
        echo "SERVER DIED after $((i*10))s - last 60 lines:"
        tail -60 "$SERVER_LOG"
        exit 1
    fi
    [ $((i % 6)) -eq 0 ] && echo "  ...still loading ($((i*10))s)"
done

if [ "$READY" -ne 1 ]; then
    echo "TIMED OUT waiting for readiness - last 60 lines:"
    tail -60 "$SERVER_LOG"
    kill "$SERVER_PID" 2>/dev/null
    exit 1
fi

echo
echo "==================== SELF-TEST ===================="
echo "--- /v1/models ---"
curl -s -H "Authorization: Bearer $API_KEY" "http://127.0.0.1:$PORT/v1/models"
echo
echo "--- one completion (does it actually generate?) ---"
curl -s -H "Authorization: Bearer $API_KEY" -H "Content-Type: application/json" \
    -d "{\"model\":\"$SERVED_NAME\",\"messages\":[{\"role\":\"user\",\"content\":\"Reply with exactly: OK\"}],\"max_tokens\":10,\"temperature\":0}" \
    "http://127.0.0.1:$PORT/v1/chat/completions"
echo
nvidia-smi --query-gpu=index,memory.used,memory.total --format=csv

echo
echo "==================== SERVING ===================="
echo "Endpoint is up on $(hostname):$PORT until walltime expires."
echo "Tunnel with:  ssh -N -L $PORT:$(hostname):$PORT cetus"
wait "$SERVER_PID"
echo "==================== SERVER EXITED ===================="
date
