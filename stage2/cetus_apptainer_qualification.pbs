#!/bin/bash
#PBS -N uts-apptainer-caps
#PBS -q smallq
#PBS -l select=1:ncpus=1:mem=2gb
#PBS -l walltime=00:08:00
#PBS -j oe
set -eu
umask 077
cd "${PBS_O_WORKDIR:?}"
exec >"apptainer-capabilities-${PBS_JOBID}.log" 2>&1
timeout --signal=TERM --kill-after=30 420 python3 -u cetus_apptainer_qualification.py
