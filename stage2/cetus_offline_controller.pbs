#!/bin/bash
#PBS -N uts-offline-check
#PBS -q smallq
#PBS -l select=1:ncpus=1:mem=2gb
#PBS -l walltime=00:06:00
#PBS -j oe

# Synthetic compatibility fixture, not a benchmark trial or model request.
set -eu
umask 077
cd "${PBS_O_WORKDIR:?}"
exec >"offline-controller-${PBS_JOBID}.log" 2>&1
date -u
hostname
jobdir=$(mktemp -d /scratch/uts-offline-controller.XXXXXX)
echo "scratch_path=$jobdir"
export APPTAINER_CACHEDIR="$jobdir/cache"
export APPTAINER_TMPDIR="$jobdir/tmp"
mkdir -p "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR"
timeout 180 apptainer pull "$jobdir/python.sif" docker://python:3.12-slim-bookworm
instance="uts-offline-${PBS_JOBID%%.*}"
trap 'apptainer instance stop "$instance" || true' EXIT
# Deliberately fake marker. No real key is read, transmitted or installed.
export UTS_FAKE_CONTROLLER_SECRET=synthetic_not_a_real_credential
timeout 30 apptainer instance start --cleanenv --containall --writable-tmpfs \
  --no-mount home,tmp,bind-paths,hostfs,cwd,sys --net --network none --fakeroot \
  "$jobdir/python.sif" "$instance"
timeout 30 apptainer exec --cleanenv "instance://$instance" python -c '
import os, pathlib, socket
assert "UTS_FAKE_CONTROLLER_SECRET" not in os.environ
assert not pathlib.Path("/shared/homes").exists()
assert not pathlib.Path("/control").exists()
assert not pathlib.Path("/run/control-token").exists()
pathlib.Path("/tmp/fixture-result").write_text("state preserved")
print("credential_and_mount_fixture=PASS")
with socket.socket() as s:
    s.bind(("127.0.0.1",0))
    print("private_loopback_bind=PASS")
print("container_uid="+str(os.getuid()))
print("container_cpu_affinity="+str(sorted(os.sched_getaffinity(0))))
print(pathlib.Path("/proc/net/route").read_text())
'
timeout 30 apptainer exec --cleanenv "instance://$instance" python -c '
from pathlib import Path
assert Path("/tmp/fixture-result").read_text()=="state preserved"
print("separate_command_filesystem=PASS")
'
set +e
timeout 10 apptainer exec --cleanenv "instance://$instance" timeout 1 sleep 5
timeout_status=$?
set -e
test "$timeout_status" -eq 124
echo command_timeout_fixture=PASS
# API catalog only, on the trusted controller side, not inside the task.
curl --fail --silent --show-error --max-time 20 --output /dev/null \
  --write-out 'controller_catalog_http=%{http_code}\n' https://openrouter.ai/api/v1/models
apptainer instance stop "$instance"
trap - EXIT
set +e
timeout 10 apptainer exec --cleanenv "instance://$instance" true
stopped_status=$?
set -e
test "$stopped_status" -ne 0
echo stopped_instance_rejects_exec=PASS
echo scope=synthetic_offline_fixture_only_not_harbor_or_benchmark_qualification
date -u
