#!/bin/bash
#PBS -N uts-preflight
#PBS -l select=1:ncpus=2:mem=4gb
#PBS -l walltime=00:10:00
#PBS -j oe

# No credentials, model requests, benchmark solutions or agent commands.
set -u
umask 077
cd "${PBS_O_WORKDIR:?}"
exec >"preflight-${PBS_JOBID}.log" 2>&1
date -u
hostname
uname -sm
id -un
apptainer version
df -h /scratch "$PBS_O_WORKDIR"
jobdir=$(mktemp -d /scratch/uts-preflight.XXXXXX) || exit 1
export APPTAINER_CACHEDIR="$jobdir/cache"
export APPTAINER_TMPDIR="$jobdir/tmp"
mkdir -p "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR" "$jobdir/evidence"
echo "scratch_path=$jobdir"
for endpoint in https://openrouter.ai/api/v1/models https://registry-1.docker.io/v2/ https://pypi.org/simple/; do
  curl --silent --show-error --location --max-time 25 --output /dev/null --write-out "$endpoint HTTP=%{http_code}\n" "$endpoint"
  echo "network_exit=$?"
done
timeout 240 apptainer pull "$jobdir/ubuntu.sif" docker://ubuntu:24.04
pull_status=$?
echo "pull_exit=$pull_status"
if [ "$pull_status" -eq 0 ]; then
  # Prevent default home, shared cwd, temporary directories and configured binds.
  timeout 45 apptainer exec --cleanenv --containall --no-mount home,tmp,bind-paths,hostfs,cwd \
    --bind "$jobdir/evidence:/evidence" "$jobdir/ubuntu.sif" /bin/sh -c '
      id; test ! -e /shared/homes; echo shared_home_absent=$?
      test ! -e /var/run/docker.sock; echo docker_socket_absent=$?
      echo fixture > /evidence/fixture.txt
      cat /proc/self/mountinfo
    '
  echo "contained_exec_exit=$?"
  test -f "$jobdir/evidence/fixture.txt"
  echo "filesystem_roundtrip_exit=$?"
  timeout 45 apptainer exec --cleanenv --containall --no-mount home,tmp,bind-paths,hostfs,cwd \
    --net --network none "$jobdir/ubuntu.sif" /bin/sh -c 'cat /proc/net/route; id'
  echo "network_isolation_exit=$?"
  timeout 45 apptainer exec --cleanenv --containall --no-mount home,tmp,bind-paths,hostfs,cwd \
    --fakeroot "$jobdir/ubuntu.sif" /bin/sh -c 'id; test "$(id -u)" -eq 0'
  echo "fakeroot_exit=$?"
fi
# Preserve scratch for inspection; no broad cleanup or modification of host settings.
date -u
echo preflight_finished
