#!/bin/bash
#PBS -N uts-gpu-inspect
#PBS -q med_gpuq
#PBS -l select=1:ncpus=2:mem=4gb:ngpus=1
#PBS -l walltime=00:03:00
#PBS -j oe

# Hardware inspection only. No inference, secrets or benchmark task execution.
set -eu
umask 077
cd "${PBS_O_WORKDIR:?}"
exec >"gpu-inspect-${PBS_JOBID}.log" 2>&1
date -u
hostname
uname -sm
printf 'CUDA_VISIBLE_DEVICES=%s\n' "${CUDA_VISIBLE_DEVICES-UNSET}"
printf 'NVIDIA_VISIBLE_DEVICES=%s\n' "${NVIDIA_VISIBLE_DEVICES-UNSET}"
printf 'PBS_GPUFILE=%s\n' "${PBS_GPUFILE-UNSET}"
if [ -n "${PBS_GPUFILE-}" ] && [ -r "$PBS_GPUFILE" ]; then cat "$PBS_GPUFILE"; fi
nvidia-smi --query-gpu=index,name,uuid,memory.total,driver_version,compute_cap --format=csv
nvidia-smi --query-gpu=index,memory.used,memory.free --format=csv
apptainer version
python3 --version
gcc --version | head -1
cmake --version | head -1
df -h /scratch
curl --silent --show-error --max-time 15 --output /dev/null \
  --write-out 'huggingface_metadata_http=%{http_code}\n' \
  https://huggingface.co/api/models/Qwen/Qwen3-Coder-Next-GGUF
echo gpu_inspection_finished
date -u
